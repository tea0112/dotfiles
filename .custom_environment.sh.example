# Must have .../gateway for Anthropic
export ANTHROPIC_BASE_URL="https://ai.com/gateway"
export ANTHROPIC_AUTH_TOKEN="<your key>"
# Keep haiku on M2.7 — it's literally designed for this slot
export ANTHROPIC_DEFAULT_HAIKU_MODEL="MiniMax/MiniMax-M3[1m]"
# opus/sonnet/default get M3 with 1M context for the heavy lifting
export ANTHROPIC_DEFAULT_OPUS_MODEL="MiniMax/MiniMax-M3[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="MiniMax/MiniMax-M3[1m]"
export ANTHROPIC_MODEL="MiniMax/MiniMax-M3[1m]"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=850000

alias ccn='ANTHROPIC_MODEL="MiniMax/MiniMax-M3[1m]" ANTHROPIC_DEFAULT_FABLE_MODEL="MiniMax/MiniMax-M3[1m]" ANTHROPIC_DEFAULT_HAIKU_MODEL="MiniMax/MiniMax-M3[1m]" ANTHROPIC_DEFAULT_OPUS_MODEL="MiniMax/MiniMax-M3[1m]" ANTHROPIC_DEFAULT_SONNET_MODEL="MiniMax/MiniMax-M3[1m]" ANTHROPIC_BASE_URL="https://net.vietnam.vn/gateway" ANTHROPIC_AUTH_TOKEN="sk-..." claude'
alias cco='ANTHROPIC_MODEL="deepseek-v4-flash[1m]" ANTHROPIC_DEFAULT_FABLE_MODEL="deepseek-v4-flash[1m]" ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash[1m]" ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-flash[1m]" ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-flash[1m]" ANTHROPIC_BASE_URL="https://opencode.ai/zen/go" ANTHROPIC_API_KEY="sk-..." claude'

# pdf convert into obsidian docling
export DOCLING_VLM_BASE_URL="https://opencode.ai/zen/go/v1"
export DOCLING_VLM_API_KEY="sk-...."
export DOCLING_VLM_MODEL="mimo-v2.5"
export DOCLING_TEXT_BASE_URL="https://provider.com/gateway/v1"
export DOCLING_TEXT_API_KEY="sk-..."
export DOCLING_TEXT_MODEL="MiniMax/MiniMax-M2.7"

export GEMINI_API_KEY="apikey"

# Alias syntax: wrap the full command in single quotes
# alias myproject='cd ~/Projects/myproject && ./dev.sh'

# Use the Windows environment variable for the profile for WSL
export WINDOWS_USER=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
export WINDOWS_SCREENSHOTS_PATH="/mnt/c/Users/$WINDOWS_USER/OneDrive/Pictures/Screenshots"

export OPENCODE_GO_API_KEY="your_api_key_here"
export OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"

export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export OPENCODE_EXPERIMENTAL_PARALLEL=true
export OPENCODE_EXPERIMENTAL_SCOUT=true
export OPENCODE_EXPERIMENTAL_EXA=true
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

# --- Claude Code: keep this machine awake while a session runs ---------------
# Idle suspend is 20 min on AC / 15 min on battery, which cuts long runs short.
# Inhibits *idle* only, NOT sleep, so `systemctl suspend` and the /sleep command
# from the Telegram bot still work.  The lock lasts exactly as long as the claude
# process, so it cannot leak if the session crashes.
#
# ccn / cco end in `claude`, so they pick this up automatically: the env
# assignments pass through the function to the real binary (verified in zsh+bash).
# Override the binary location with CLAUDE_BIN if it ever moves.
claude() {
    local bin="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
    if [ ! -x "$bin" ]; then
        # Resolve the real binary while skipping this function.
        if [ -n "$ZSH_VERSION" ]; then bin=$(whence -p claude)
        elif [ -n "$BASH_VERSION" ]; then bin=$(type -P claude)
        else bin=""
        fi
    fi
    [ -n "$bin" ] && [ -x "$bin" ] || { echo "claude: binary not found" >&2; return 127; }

    if [ -n "$DBUS_SESSION_BUS_ADDRESS" ] && command -v gnome-session-inhibit >/dev/null 2>&1; then
        gnome-session-inhibit --inhibit idle --reason "Claude Code session" "$bin" "$@"
    else
        "$bin" "$@"   # no GNOME session (e.g. plain SSH): run unwrapped
    fi
}
