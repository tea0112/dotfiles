#!/bin/bash

# go install golang.org/dl/go1.21.0@latest
# go1.21.0 download
# go1.21.0 version
#alias makegen="go generate ./..."

export PGPASSWD=Postgres!23456
export PGUSER=postgres
export PGPORT=5432
export PGDB=postgres
# export GOPRIVATE=dev.azure.com
export GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

export AI_GATEWAY_BASE_URL="https://ai.com/gateway/v1"
export AI_GATEWAY_API_KEY="sk-"
export AI_GATEWAY_MODEL="MiniMax/MiniMax-M2.7"
export MY_AGENT_MODEL="aigateway/MiniMax/MiniMax-M2.7"
export OPENCODE_AGENT_MODEL="${MY_AGENT_MODEL:-opencode-go/deepseek-v4-flash}"

# Must have .../gateway for Anthropic
export ANTHROPIC_BASE_URL="https://ai.com/gateway"
export ANTHROPIC_AUTH_TOKEN="<your key>"
# Keep haiku on M2.7 — it's literally designed for this slot
export ANTHROPIC_DEFAULT_HAIKU_MODEL="MiniMax/MiniMax-M3[1m]"
# opus/sonnet/default get M3 with 1M context for the heavy lifting
export ANTHROPIC_DEFAULT_OPUS_MODEL="MiniMax/MiniMax-M3[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="MiniMax/MiniMax-M3[1m]"
export ANTHROPIC_MODEL="MiniMax/MiniMax-M3[1m]"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=850000

# pdf convert into obsidian docling
export DOCLING_VLM_BASE_URL="https://opencode.ai/zen/go/v1"
export DOCLING_VLM_API_KEY="sk-...."
export DOCLING_VLM_MODEL="mimo-v2.5"
export DOCLING_TEXT_BASE_URL="https://provider.com/gateway/v1"
export DOCLING_TEXT_API_KEY="sk-..."
export DOCLING_TEXT_MODEL="MiniMax/MiniMax-M2.7"

# Alias syntax: wrap the full command in single quotes
# alias myproject='cd ~/Projects/myproject && ./dev.sh'

# Use the Windows environment variable for the profile for WSL
export WINDOWS_USER=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r\n')
export WINDOWS_SCREENSHOTS_PATH="/mnt/c/Users/$WINDOWS_USER/OneDrive/Pictures/Screenshots"

export OPENCODE_GO_API_KEY="your_api_key_here"
export OPENCODE_GO_BASE_URL="https://opencode.ai/zen/go/v1"

export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export OPENCODE_EXPERIMENTAL_PARALLEL=true
export OPENCODE_EXPERIMENTAL_SCOUT=true
export OPENCODE_EXPERIMENTAL_EXA=true
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true
