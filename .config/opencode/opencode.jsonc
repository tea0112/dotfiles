{
  "$schema": "https://opencode.ai/v2/openapi.json#/components/schemas/Config.Info",

  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      "google-search": {
        "type": "local",
        "command": ["npx", "-y", "google-search-api-mcp"],
        "environment": {
          "GEMINI_API_KEY": "{env:GEMINI_API_KEY}",
          "GOOGLE_SEARCH_MODEL": "gemini-2.5-flash"
        }
      }
    }
  },
  "providers": {
    "netgate": {
      "name": "netGate",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:AI_GATEWAY_BASE_URL}", // https://net.vnpt.vn/gateway/v1
        "apiKey": "{env:AI_GATEWAY_API_KEY}"    // sk-...
      },
      "models": {
        "MiniMax/MiniMax-M3": {
          "modelID": "MiniMax/MiniMax-M3",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "input": 840000,
            "output": 65536
          }
        }
      }
    }
  }
}
