{
  "$schema": "https://opencode.ai/config.json",
  "model": "cocraft-local/MiniMax/MiniMax-M2.7",
  "provider": {
    "cocraft-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cocraft (Local)",
      "options": {
        "baseURL": "{env:AI_GATEWAY_BASE_URL}",
        "apiKey": "{env:AI_GATEWAY_API_KEY}"
      },
      "models": {
        "MiniMax/MiniMax-M2.7": {
          "name": "MiniMax/MiniMax-M2.7",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "limit": {
            "context": 204800,
            "output": 65536
          },
          "reasoning": true,
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}