{
  "$schema": "https://opencode.ai/config.json",
  "model": "cocraft-local/MiniMax/MiniMax-M2.7",
  "mcp": {
    "google-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "google-search-api-mcp"
      ],
      "enabled": true,
      "environment": {
        "GEMINI_API_KEY": "{env:GEMINI_API_KEY}",
        "GOOGLE_SEARCH_MODEL": "gemini-2.5-flash"
      }
    }
  },
  "provider": {
    "cocraft-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cocraft (Local)",
      "options": {
        "baseURL": "{env:AI_GATEWAY_BASE_URL}",
        "apiKey": "{env:AI_GATEWAY_API_KEY}"
      },
      "models": {
        "MiniMax/MiniMax-M2.7": {
          "name": "MiniMax/MiniMax-M2.7",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "limit": {
            "context": 204800,
            "output": 65536
          },
          "reasoning": true,
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "lsp": true,
  "agent": {
    "general": {
      "description": "General purpose agent for implementation, file edits, bash commands, and complex multi-step tasks",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "explore": {
      "description": "Fast read-only codebase exploration — find files, search code, understand structure",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "scout": {
      "description": "External dependency research — inspect libraries, clone repos, cross-reference upstream code",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}