{
  "mcpServers": {
    "google-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "google-search-api-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${MY_SECRET_TOKEN}",
        "GOOGLE_SEARCH_MODEL": "gemini-2.5-flash"
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "supabase-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "cqbjf...",
        "--read-only"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN"
      }
    },
    "dbhub-postgres-readonly": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--dsn",
        "postgres://user:password@localhost:5432/dbname?sslmode=disable",
        "--readonly"
      ]
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp/readonly"
      ]
    }
  }
}
