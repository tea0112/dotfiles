{
  "mcpServers": {
    "google-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "google-search-api-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${MY_SECRET_TOKEN}",
        "GOOGLE_SEARCH_MODEL": "gemini-2.5-flash"
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "supabase-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "cqbjfh..."
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN"
      }
    },
    "postgres-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres?options=-c%20default_transaction_read_only=on"
      ]
    }
  }
}
